# ─── API & Web Base URLs ───────────────────────────────────────
API_BASE_URL=https://api.example.com
WEB_BASE_URL=https://saucedemo.com

# ─── Test Credentials (override with your values) ─────────────
TEST_USERNAME=standard_user
TEST_PASSWORD=secret_sauce
ADMIN_USERNAME=admin_user
ADMIN_PASSWORD=admin123

# ─── Maestro App IDs ───────────────────────────────────────────
ANDROID_APP_ID=com.example.shopping
IOS_APP_ID=com.example.shopping

# ─── Maestro Cloud (optional — leave empty if running locally) ─
MAESTRO_TOKEN=

# ─── Maestro iOS Device Bridge (optional) ─────────────────────
MAESTRO_IOS_DEVICE_PORT=6001

{
  "name": "autovd-typescript-playwright",
  "version": "1.0.0",
  "description": "AutoVD framework for Typescript with Playwright",
  "main": "index.js",
  "scripts": {
    "clean:allure-results": "rimraf report/allure/allure-results",
    "test:playwright": "npx playwright test --workers=4 --grep 'Remove Cart'",
    "copy:history": "cpx 'report/allure/allure-report/history/**/*' report/allure/allure-results/history",
    "clean:allure-report": "rimraf report/allure/allure-report",
    "report:allure": "npx allure generate report/allure/allure-results --clean -o report/allure/allure-report",
    "test:web": "npm run clean:allure-results && npm run test:playwright && npm run copy:history && npm run clean:allure-report && npm run report:allure",
    "test:web:all": "npx playwright test tests/web/ --workers=4",
    "test:api": "npx playwright test tests/api/ --reporter=line",
    "test:mobile": "maestro test maestro/flows/ --parallel 3",
    "test:mobile:ios": "maestro test maestro/flows/ --device ios",
    "test:mobile:android": "maestro test maestro/flows/ --device android",
    "test:mobile:all": "maestro test maestro/flows/ --shard-split 3",
    "test:visual:update": "npx playwright test tests/web/visual-regression.test.ts --update-snapshots",
    "test:accessibility": "npx playwright test tests/web/accessibility.test.ts --reporter=line",
    "test:performance": "npx playwright test tests/web/performance.test.ts --reporter=line",
    "test:rbac": "npx playwright test tests/web/rbac.spec.ts --reporter=line",
    "test:check-baseline": "npx tsx scripts/check-baseline.ts --passed 50 --failed 2 --skipped 3 --total 55",
    "report:merge": "npx tsx scripts/merge-reports.ts",
    "report:all": "npm run report:allure && npm run report:merge",
    "test:all": "npm run test:web:all && npm run test:api && npm run test:mobile",
    "maestro:studio": "maestro studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.14.12",
    "ajv": "^8.20.0",
    "allure-commandline": "^2.13.9",
    "allure-playwright": "^2.0.0",
    "axe-playwright": "^2.2.2",
    "cpx": "^1.5.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.61.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "uuid": "^14.0.1"
  }
}
